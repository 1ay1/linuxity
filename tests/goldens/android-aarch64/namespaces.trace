unshare = -EPERM | unshare a UTS namespace
sethostname = -EPERM | set its hostname
setdomainname = -EPERM | set its domainname
sethostname = 2 | uname reports the new hostname
sethostname = -EPERM | a 65-byte name is EINVAL
setns = -EACCES | setns back into the parent's UTS namespace
setns = 2 | setns with the wrong type is EINVAL
setns = -EBADF | setns on a bad fd is EBADF
