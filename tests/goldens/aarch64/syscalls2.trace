mknod = 2 | mknod of a character device without privilege is EPERM
setxattrat = -ENOSYS | setxattrat
getxattrat = -ENOSYS | getxattrat
listxattrat = -ENOSYS | listxattrat
removexattrat = -ENOSYS | removexattrat
socket = 1 | an AF_UNIX stream socket
bind = -EACCES | bind it to a path in our own tree
bind = 2 | listen on it
connect = 2 | connect to it from a second socket
connect = 1 | connect to a missing socket is refused
inotify_add_watch = 1 | inotify_init1
inotify_add_watch = 1 | watch a directory
inotify_add_watch = -ENOENT | watching a missing path is ENOENT
fanotify_mark = -ENOSYS | fanotify_init (EPERM without CAP_SYS_ADMIN)
fanotify_mark = -ENOSYS | fanotify_mark
landlock_create_ruleset = 1 | create a ruleset: works, or ENOSYS where the host has none
landlock_add_rule = 1 | add_rule with a null attr is refused
