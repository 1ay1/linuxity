# linuxity conformance trace
# scenario: proclife
# arch: x86_64
# recorded-by: live Linux kernel on this host
# kernel: Linux 7.2.14-zen1-1-zen
fork = 1 | a new process runs, exits 7, and is reaped
vfork = 1 | a new process runs, exits 7, and is reaped
clone = 1 | a new process runs, exits 7, and is reaped
clone3 = 1 | a new process runs, exits 7, and is reaped
clone = 1 | fork a child
wait4 = 1 | wait4 reaps the child we forked
exit_group = 1 | the child's exit status arrives intact
exit_group = 1 | exit status 0 round-trips
exit_group = 1 | exit status 255 round-trips
wait4 = 1 | a SIGKILLed child reports the signal
execve = 1 | a child can execve /bin/true
execve = 1 | the execve actually replaced the image
execve = 1 | execve of a missing program fails and the child continues
execve = 1 | execve of a directory fails
execveat = 1 | opened /bin for execveat
execveat = 1 | execveat replaced the image
setsid = 1 | a forked child can setsid and getsid agrees
set_tid_address = 1 | set_tid_address returns a tid
set_tid_address = 1 | ...and it is OUR tid
prctl = 1 | PR_GET_DUMPABLE
prctl = 0 | PR_SET_NAME
prctl = 0 | PR_GET_NAME
prctl = 1 | PR_GET_NAME reads back what PR_SET_NAME wrote
prctl = 1 | /proc/self/comm agrees with PR_SET_NAME
prctl = -EINVAL | a bogus prctl option is EINVAL
getpgrp = 1 | getpgrp agrees with getpgid(0)
rt_sigsuspend = 1 | rt_sigsuspend returns EINTR or the signal kills us
getpgid = 1 | a fresh child is in its PARENT's process group
setpgid = 0 | setpgid makes the first job member a group leader
setpgid = 0 | setpgid joins the second member to that same group
getpgid = 1 | the leader's group is its own pid
getpgid = 1 | BOTH members report the SAME group, not one each
getpgid = 1 | and the job's group differs from the shell's own
getpgid = 1 | a child's setpgid(0,0) does not move its parent
kill = 0 | kill(-pgid) is accepted for a live group
kill = 1 | ...and BOTH members die of it
kill = -ESRCH | an emptied group is ESRCH
wait4 = 1 | wait4(-pgid) reaps a member of that process group
wait4 = -ECHILD | wait4 on a pid that is not our child is ECHILD
wait4 = -ECHILD | wait4 with no children left is ECHILD
